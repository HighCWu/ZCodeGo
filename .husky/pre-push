#!/usr/bin/env sh

# 推送前先跑 lint 再跑单测，先用更快的静态检查尽早拦住低成本问题，
# 避免还没过代码质量门槛就进入更慢的测试阶段。
# Git 会通过 stdin 传入本次 push 的 local/remote ref 与 sha；先缓存下来，后续
# affected-test 脚本才能用远端当前 sha 作为 base，而不是误退回到默认分支。
# 手工执行 hook 时 stdin 可能是终端，避免直接 cat 卡住调试。
pre_push_stdin=""
if [ ! -t 0 ]; then
  pre_push_stdin=$(cat)
fi
# Bugfix: Git hook 会注入 GIT_DIR/GIT_WORK_TREE 等 local env。
# 不清理会让单测里的临时仓库 Git 命令误命中当前仓库（例如把功能分支改名为 main）。
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)
# 修复原因：强制 mise 会阻止已用其他方式准备好 Node/pnpm 的开发者推送；沿用当前环境。
# zcode-go：本地 node 与 mise.toml 基线漂移时（如 nvm 漂到 Node 25 会令 jsdom 29
# 的 localStorage 失效），受影响单测整组假失败拦推送。测试的真门禁在 CI
# （official-e2e 复用官版 zcode electron 的装配链路）——node 主版本不一致时
# 跳过单测段（lint/架构检查与 node 版本无关，照跑），测试由 CI 兜底。
required_node_major=$(sed -n 's/^node *= *"\([0-9]*\)\..*"/\1/p' mise.toml | head -1)
if [ -n "$required_node_major" ] \
  && [ "$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null)" != "$required_node_major" ]; then
  echo "[pre-push] node $(node -v 2>/dev/null) ≠ mise.toml 基线 ${required_node_major}.x：跳过受影响单测（CI 兜底）"
  ZCODE_PRE_PUSH_STDIN="$pre_push_stdin" pnpm run lint \
    && ZCODE_PRE_PUSH_STDIN="$pre_push_stdin" pnpm run architecture:check -- --changed
  exit $?
fi
ZCODE_PRE_PUSH_STDIN="$pre_push_stdin" pnpm run verify:pre-push
